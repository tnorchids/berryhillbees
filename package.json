{
  "name": "bhb-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contact:deploy": "wrangler deploy --config worker/wrangler.contact.jsonc",
    "contact:secret": "wrangler secret put --config worker/wrangler.contact.jsonc",
    "contact:logs": "wrangler tail --config worker/wrangler.contact.jsonc",
    "test": "node --test src/utils/*.test.js worker/*.test.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/generate-page-metadata.js",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
